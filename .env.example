# HTTP listen address. TLS is terminated by the CDN or a reverse proxy.
LIFEMAIL_ADDR=:8080

# Storage: a file path opens SQLite (default), a postgres:// URL opens PostgreSQL.
LIFEMAIL_DB_DSN=/data/lifemail.db
# LIFEMAIL_DB_DSN=postgres://lifemail:secret@db:5432/lifemail?sslmode=disable

# Apply pending migrations at startup. Turn off when "lifemail db migrate"
# runs as a separate deployment step.
LIFEMAIL_AUTO_MIGRATE=1

# Shared secret used by the Cloudflare Worker forwarding inbound mail.
LIFEMAIL_INBOUND_TOKEN=change-me

# Token for /api/admin/* and the admin console.
LIFEMAIL_ADMIN_TOKEN=change-me-too

# MIME bodies and attachment payloads live here, outside the database.
# It can be an rclone mount; back it up together with the database.
LIFEMAIL_ATTACHMENT_DIR=/data/attachments

# Used to print absolute calendar subscription links. Optional.
LIFEMAIL_PUBLIC_BASE_URL=https://mail.example.com

# Keep raw WBXML request bodies for diagnostics. Optional.
# LIFEMAIL_EAS_DUMP=/tmp/easdump

LIFEMAIL_LOG_LEVEL=info
